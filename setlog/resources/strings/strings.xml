    <string id="NoPhone">Phone not connected</string>
    <string id="Sending">Sending...</string>
    <string id="Sent">Sent</string>
    <string id="SendFailed">Send failed: $1$</string>

    <!-- Settings: used on the watch and in the phone app -->
    <string id="SetUnits">Weight units</string>
    <string id="UnitsWatch">Watch setting</string>
    <string id="UnitsKg">kg</string>
    <string id="UnitsLb">lb</string>
    <string id="SetVibrate">Vibrate after rest</string>
    <string id="SetTone">Beep after rest</string>

    <!-- Settings only shown in the phone app: scope="settings" keeps them out of the watch's memory. -->
    <string id="SetRest" scope="settings">Rest time (seconds)</string>
    <string id="SetExportUrl" scope="settings">Export URL (receives a POST)</string>
    <string id="SetPlanUrl" scope="settings">Plan URL (JSON with a "note")</string>

    <!-- Labels Garmin Connect shows for the FIT developer fields -->
    <string id="FitReps">Reps</string>
    <string id="FitRepsUnit">reps</string>
    <string id="FitLoad">Load</string>
    <string id="FitKg">kg</string>
